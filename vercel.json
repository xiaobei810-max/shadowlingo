{
  "version": 2,
  "functions": {
    "api/evaluate.js": { "maxDuration": 30 },
    "api/tts.js":      { "maxDuration": 10 },
    "api/ping.js":     { "maxDuration": 10 }
  },
  "routes": [
    { "src": "/go", "status": 302, "headers": { "Location": "/?utm_source=youtube&utm_medium=shorts&utm_content=endcard" } },
    { "src": "/tt", "status": 302, "headers": { "Location": "/?utm_source=tiktok&utm_medium=shorts&utm_content=bio" } },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)",     "dest": "/public/index.html" }
  ]
}
